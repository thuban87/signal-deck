# Environment variables for local development
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# Auth credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-string

# Alpaca API (sign up at https://alpaca.markets for free)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8005

# Finnhub API (free tier — sign up at https://finnhub.io for free)
FINNHUB_API_KEY=

# Alpha Vantage API (economic indicators — sign up at https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# Reddit API (optional — social momentum scanning)
# Create a "script" app at https://www.reddit.com/prefs/apps/
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Ollama (optional — only needed for LLM analysis button)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
